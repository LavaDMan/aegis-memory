# AEGIS Memory SDK — Environment Template
# Copy this to .env and fill in your server details

# Postgres (Ledger)
POSTGRES_URL=postgresql://user:password@10.0.0.100:5432/aegis_local

# Qdrant (Semantic)
QDRANT_URL=http://10.0.0.100:6333

# Neo4j (Graph)
NEO4J_URI=bolt://10.0.0.100:7687
NEO4J_PASSWORD=your_actual_password

# Ollama (Embeddings)
OLLAMA_URL=http://10.0.0.100:11434

# Ph1917 — Memory Lifecycle Decay
# Set TRIPARTITE_DECAY_ENABLED=false to bypass score decay entirely
TRIPARTITE_DECAY_ENABLED=true
TRIPARTITE_DECAY_THRESHOLD_DAYS_90=90
TRIPARTITE_DECAY_THRESHOLD_DAYS_180=180
TRIPARTITE_DECAY_THRESHOLD_DAYS_365=365

# Ph1917 — Nightly Pruning Job
# Collections to scan (comma-separated)
PRUNING_COLLECTIONS=execution_memory,john_context,forge_context
# Points older than this AND below score threshold are flagged for KNO-01 review
PRUNING_MIN_AGE_DAYS=180
PRUNING_SCORE_THRESHOLD=0.5
# Set to true to print candidates without posting to KNO-01
PRUNING_DRY_RUN=false
